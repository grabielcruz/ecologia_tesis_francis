{
  "name": "projecto",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -P tsconfig.server.json server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "seed": "tsc -p tsconfig.server.json && node dist/server/seeds.js",
    "dev:seed": "npm run seed && npm run dev",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sequelize": "^6.34.1",
    "sqlite3": "^5.1.6",
    "multer": "^1.4.5-lts.1",
      "sharp": "^0.32.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.19",
    "@types/multer": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.14.5",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
