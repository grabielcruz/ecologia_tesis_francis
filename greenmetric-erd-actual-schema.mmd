erDiagram
    %% Exact schema from server/models.ts (Sequelize models)

    Role {
        int role_id PK
        string role_name
        string description
        datetime created_at
        datetime updated_at
    }

    User {
        int user_id PK
        string name
        string email
        string username
        string password_hash
        string avatar_url
        boolean is_active
        int role_id FK
        datetime created_at
        datetime updated_at
    }

    GreenSpace {
        int space_id PK
        string name
        string location
        int total_area_m2
        int trees_count
        text images
        datetime created_at
        datetime updated_at
    }

    GreenSpaceReview {
        int green_space_review_id PK
        int space_id FK
        int user_id FK
        string review_notes
        int rating
        datetime created_at
        datetime updated_at
    }

    TreeType {
        int type_id PK
        string name
        string description
        text reference_images
        datetime created_at
        datetime updated_at
    }

    TreeInventory {
        int tree_id PK
        string name
        enum health_status "healthy|regular|sick|dead"
        int space_id FK
        int type_id FK
        datetime created_at
        datetime updated_at
    }

    ReportOfGreenArea {
        int report_of_green_area_id PK
        string title
        text description
        text url_images
        string state
        datetime created_at
        datetime updated_at
        int user_id FK
        int space_id FK
    }

    ProposalOfGreenArea {
        int proposal_of_green_area_id PK
        string title
        text description
        enum status "draft|open|closed|approved|rejected"
        int total_votes
        datetime voting_starts "nullable"
        datetime voting_ends "nullable"
        int user_id FK
        int space_id FK
        datetime created_at
        datetime updated_at
    }

    ProjectOfProposal {
        int project_of_proposal_id PK
        string title
        text description
        enum completed_status "planned|in_progress|completed"
        int proposal_of_green_area_id FK
        int space_id FK
        datetime created_at
        datetime updated_at
    }

    ProjectUpdateOfProposal {
        int project_update_of_proposal_id PK
        string title
        text description
        text activity_images
        int project_of_proposal_id FK
        int user_id FK
        datetime created_at
        datetime updated_at
    }

    VoteOfProposal {
        int vote_of_proposal_id PK
        int proposal_of_green_area_id FK
        int user_id FK
        datetime created_at
    }

    %% Relationships defined in Sequelize associations
    Role ||--o{ User : assigns

    User ||--o{ ReportOfGreenArea : creates
    GreenSpace ||--o{ ReportOfGreenArea : has

    User ||--o{ GreenSpaceReview : writes
    GreenSpace ||--o{ GreenSpaceReview : has

    User ||--o{ ProposalOfGreenArea : proposes
    GreenSpace ||--o{ ProposalOfGreenArea : has

    ProposalOfGreenArea ||--o{ VoteOfProposal : receives
    User ||--o{ VoteOfProposal : casts

    ProposalOfGreenArea ||--o{ ProjectOfProposal : generates
    GreenSpace ||--o{ ProjectOfProposal : has
    ProjectOfProposal ||--o{ ProjectUpdateOfProposal : logs
    User ||--o{ ProjectUpdateOfProposal : records

    GreenSpace ||--o{ TreeInventory : contains
    TreeType ||--o{ TreeInventory : classifies
