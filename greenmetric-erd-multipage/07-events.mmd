erDiagram
    Event {
        int event_id PK
        string title
        text description
        datetime event_date "nullable"
        enum status "open|closed"
        text closure_description "nullable"
        text closure_images
        int created_by_user_id FK
        datetime created_at
        datetime updated_at
    }
    EventEnrollment {
        int event_enrollment_id PK
        int event_id FK "unique with user_id"
        int user_id FK "unique with event_id"
        datetime created_at
    }
    User {
        int user_id PK
        string referencia
    }
    User ||--o{ Event : crea
    Event ||--o{ EventEnrollment : tiene_participantes
    User ||--o{ EventEnrollment : se_inscribe
