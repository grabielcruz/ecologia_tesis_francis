# Copy this file to .env and fill the real values
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_OUTPUT_TOKENS=90000

# Auth email workflow (Mailtrap SMTP for testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
MAIL_FROM="Univerde <no-reply@univerde.local>"

# Frontend base URL used in reset links
APP_BASE_URL=http://localhost:5173

# JWT secret for auth and password reset tokens
JWT_SECRET=replace_with_a_secure_secret

# Reset-link expiration in minutes
PASSWORD_RESET_EXPIRATION_MINUTES=30
