erDiagram
    %% Capa de Usuarios y Roles
    User {
        int user_id PK
        string name
        string email
        string username
        string password_hash
        string avatar_url
        boolean is_active
        int role_id FK
        datetime created_at
        datetime updated_at
    }

    Role {
        int role_id PK
        string role_name
        string description
        datetime created_at
        datetime updated_at
    }

    %% Capa de Áreas Verdes (GIS/Inventario)
    GreenSpace {
        int space_id PK
        string name
        string location 
        int total_area_m2
        int trees_count
        string images
        datetime created_at
        datetime updated_at
    }

    GreenSpaceReview {
        int green_space_review_id PK
        int space_id FK
        int user_id FK
        string review_notes
        int rating
        datetime created_at
        datetime updated_at
    }

    TreeType {
        int type_id PK
        string name
        string description
        string reference_images
        datetime created_at
        datetime updated_at
    }

    TreeInventory {
        int tree_id PK
        string name
        enum health_status
        int space_id FK
        int type_id FK
        datetime created_at
        datetime updated_at
    }

    %% Capa de Participación Ciudadana
    ReportOfGreenArea {
        int report_of_green_area_id PK
        string title
        text description
        string url_images
        string state
        datetime created_at
        datetime updated_at
        int user_id FK
        int space_id FK
    }

    ProposalOfGreenArea {
        int proposal_of_green_area_id PK
        string title
        string description
        enum status 
        int total_votes
        int user_id FK
        int space_id FK
    }

    VoteOfProposal {
        int vote_of_proposal_id PK
        int proposal_of_green_area_id FK
        int user_id FK
        datetime created_at
    }

    %% Relaciones principales (físicas)
    Role ||--o{ User : asigna
    User ||--o{ ReportOfGreenArea : crea
    User ||--o{ ProposalOfGreenArea : propone
    User ||--o{ VoteOfProposal : realiza
    User ||--o{ GreenSpaceReview : realiza
    ProposalOfGreenArea ||--o{ VoteOfProposal : recibe

    TreeType ||--o{ TreeInventory : clasifica
    GreenSpace ||--o{ TreeInventory : contiene
    GreenSpace ||--o{ GreenSpaceReview : contiene

    %% Relaciones conceptuales (sin FK explícita en el esquema)
    GreenSpace o|..o{ ReportOfGreenArea : puede_afectar_a
    GreenSpace o|..o{ ProposalOfGreenArea : puede_proponerse_en